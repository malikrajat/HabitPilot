{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HabitPilot",
  "version": "0.1.0",
  "identifier": "app.habitpilot.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @habitpilot/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @habitpilot/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HabitPilot",
        "width": 1280,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "HabitPilot",
    "category": "Healthcare and Fitness",
    "shortDescription": "Local-first habit and health tracking",
    "longDescription": "HabitPilot keeps health data in local SQLite, stores provider credentials in the operating system secret store, and requires explicit consent before any AI request."
  }
}
