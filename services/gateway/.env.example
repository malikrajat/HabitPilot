# Server-only configuration for the HabitPilot AI gateway.
# Copy to `.env` and run the gateway with a process manager that loads it.
#
# NEVER prefix these with VITE_. VITE_ variables are compiled into the browser
# bundle. Provider credentials must exist only in the server environment.

HABITPILOT_GATEWAY_PORT=8787
HABITPILOT_GATEWAY_HOST=127.0.0.1

# At least 32 characters. Generate with: openssl rand -base64 48
HABITPILOT_SESSION_SECRET=replace-with-a-long-random-secret

# A single server-managed provider. Clients cannot switch it.
HABITPILOT_AI_PROVIDER=openai
HABITPILOT_AI_MODEL=gpt-5-mini
# Optional. Only for self-hosted OpenAI-compatible endpoints.
# HABITPILOT_AI_BASE_URL=http://127.0.0.1:8000/v1

# Exactly one provider key, read by the server only.
OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# HABITPILOT_AI_API_KEY=

# Comma-separated browser origins allowed to call the gateway.
HABITPILOT_ALLOWED_ORIGINS=http://localhost:5173

HABITPILOT_RATE_LIMIT_PER_MINUTE=20

# Optional JSON file for server-side consent records (metadata only).
# HABITPILOT_CONSENT_FILE=./data/consent.json
